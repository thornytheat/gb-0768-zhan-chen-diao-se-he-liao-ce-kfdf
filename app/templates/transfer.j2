<section class="panel folio"><div class="folio-head"><h2>倒料对账凭据</h2><span>出罐当天扣减 · 收罐按实收入账</span></div>
<div class="scroll"><table><thead><tr><th>出罐票 / 走向</th><th>出罐时刻</th><th>实发 g</th><th>实发成分 g</th><th>收罐票</th><th>实收 g</th><th>短少批号 g</th><th>状态</th></tr></thead><tbody>
{% for p in data.transfer.pours %}<tr><th scope="row">{{ p.out_ticket }} / {{ p.source_pot }} → {{ p.target_pot }}</th><td>{{ studio_label(p.at) }}</td><td>{{ grams(p.issued_mg) }}</td><td>{% for lot,qty in p.issued_parts.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td><td>{% if p.in_ticket %}{{ p.in_ticket }} · {{ studio_label(p.received_at) }}{% if p.delay %} · 迟补{% endif %}{% else %}—{% endif %}</td><td>{{ grams(p.received_mg) }}</td><td>{% if p.shortage_mg %}{% for lot,qty in p.shortage_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}{% elif p.in_ticket %}—{% else %}<span class="allocation">待收</span>{% endif %}</td><td>{{ labels[p.code] }}</td></tr>{% else %}<tr><td colspan="8">本工单没有倒料记录。</td></tr>{% endfor %}</tbody></table></div></section>
{% if data.transfer.awaited %}<section class="panel folio"><h2>等实收补足后入账的上件</h2><div class="scroll"><table><thead><tr><th>票号 / 罐</th><th>净重 g</th><th>成分分摊 g</th></tr></thead><tbody>{% for r in data.transfer.awaited %}<tr><th scope="row">{{ r.data.ticket }} / {{ r.data.pot }}</th><td>{{ grams(r.net_mg) }}</td><td>{% for lot,qty in r.parts_mg.items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% include 'rejects.j2' %}
